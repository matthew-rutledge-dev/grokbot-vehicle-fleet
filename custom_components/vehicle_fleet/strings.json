{
  "application_credentials": {
    "description": "Enter the client ID and client secret of your own Fleet API application from {developer_url}. Its allowed redirect URIs must include {redirect_url}."
  },
  "config": {
    "step": {
      "pick_implementation": {
        "title": "[%key:common::config_flow::title::oauth2_pick_implementation%]"
      },
      "region": {
        "title": "Fleet API region",
        "description": "Pick the region of your account, or Auto to detect it.",
        "data": {
          "region": "Region"
        }
      },
      "reauth_confirm": {
        "title": "[%key:common::config_flow::title::reauth%]",
        "description": "The Vehicle Fleet integration needs you to sign in again."
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "reauth_account_mismatch": "Signed in with a different account than the one being re-authenticated.",
      "invalid_token": "The token returned by the sign-in could not be read.",
      "no_vehicles": "No vehicles were found on this account.",
      "missing_configuration": "[%key:common::config_flow::abort::oauth2_missing_configuration%]",
      "missing_credentials": "[%key:common::config_flow::abort::oauth2_missing_credentials%]",
      "authorize_url_timeout": "[%key:common::config_flow::abort::oauth2_authorize_url_timeout%]",
      "no_url_available": "[%key:common::config_flow::abort::oauth2_no_url_available%]",
      "oauth_error": "[%key:common::config_flow::abort::oauth2_error%]",
      "oauth_timeout": "[%key:common::config_flow::abort::oauth2_timeout%]",
      "oauth_unauthorized": "[%key:common::config_flow::abort::oauth2_unauthorized%]",
      "oauth_failed": "[%key:common::config_flow::abort::oauth2_failed%]",
      "user_rejected_authorize": "[%key:common::config_flow::abort::oauth2_user_rejected_authorize%]"
    },
    "create_entry": {
      "default": "[%key:common::config_flow::create_entry::authenticated%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Vehicle Fleet options",
        "description": "Polling never wakes the car: each poll first reads the vehicle state, and reads vehicle data (billed) only while the car is already online. Commands are off by default (read-only).",
        "data": {
          "scan_interval_minutes": "Poll interval (minutes)",
          "location": "Read location",
          "commands_enabled": "Enable commands",
          "proxy_url": "Command proxy URL",
          "proxy_ca_cert": "Command proxy CA certificate path"
        },
        "data_description": {
          "scan_interval_minutes": "Minimum 5. Each poll is one state read, plus one billed vehicle data read only when the car is online.",
          "location": "Adds a location tracker. The car shows a location-sharing indicator when location is read.",
          "commands_enabled": "Creates lock, climate, switch and button entities. Do not use them in automations.",
          "proxy_url": "Base URL of your tesla-http-proxy (https; plain http only on localhost). Required for commands.",
          "proxy_ca_cert": "Optional path to a CA certificate file that signed the proxy's TLS certificate."
        }
      }
    },
    "error": {
      "invalid_url": "Enter a valid https URL without credentials, query or fragment.",
      "http_not_loopback": "Plain http is only allowed for a proxy on this machine (localhost).",
      "proxy_required": "A command proxy URL is required to enable commands.",
      "ca_not_found": "The CA certificate file was not found."
    }
  },
