{
  "mcpServers": {
    "vehicle-fleet": {
      "command": "node",
      "args": [
        "${CURSOR_PLUGIN_ROOT}/mcp/vehicle-fleet/dist/index.js"
      ],
      "cwd": "${CURSOR_PLUGIN_ROOT}/mcp/vehicle-fleet",
      "env": {
        "TESLA_CLIENT_ID": "${TESLA_CLIENT_ID}",
        "TESLA_FLEET_CLIENT_ID": "${TESLA_FLEET_CLIENT_ID}",
        "TESLA_REFRESH_TOKEN": "${TESLA_REFRESH_TOKEN}",
        "TESLA_FLEET_REGION": "${TESLA_FLEET_REGION}",
        "TESLA_FLEET_BASE_URL": "${TESLA_FLEET_BASE_URL}",
        "TESLA_COMMAND_PROXY_URL": "${TESLA_COMMAND_PROXY_URL}",
        "TESLA_FLEET_PROXY_URL": "${TESLA_FLEET_PROXY_URL}",
        "TESLA_COMMAND_PROXY_CA_CERT": "${TESLA_COMMAND_PROXY_CA_CERT}",
        "TESLA_FLEET_PROXY_CA_FILE": "${TESLA_FLEET_PROXY_CA_FILE}",
        "TESLA_TOKEN_STORE": "${TESLA_TOKEN_STORE}",
        "TESLA_FLEET_ACCESS_TOKEN_EXPORT_FILE": "${TESLA_FLEET_ACCESS_TOKEN_EXPORT_FILE}",
        "TESLA_FLEET_READ_ONLY": "${TESLA_FLEET_READ_ONLY}",
        "TESLA_FLEET_ENABLE_LOCATION": "${TESLA_FLEET_ENABLE_LOCATION}",
        "TESLA_FLEET_DEFAULT_LOCATION_PRECISION": "${TESLA_FLEET_DEFAULT_LOCATION_PRECISION}",
        "TESLA_DEFAULT_VIN": "${TESLA_DEFAULT_VIN}",
        "TESLA_DEFAULT_ENERGY_SITE_ID": "${TESLA_DEFAULT_ENERGY_SITE_ID}",
        "TESLA_FLEET_DRY_RUN": "${TESLA_FLEET_DRY_RUN}",
        "TESLA_FLEET_DEFAULT_CLIMATE_TEMP_C": "${TESLA_FLEET_DEFAULT_CLIMATE_TEMP_C}",
        "TESLA_FLEET_DEFAULT_SEAT_HEAT_LEVEL": "${TESLA_FLEET_DEFAULT_SEAT_HEAT_LEVEL}",
        "TESLA_FLEET_DEFAULT_HEATED_SEATS": "${TESLA_FLEET_DEFAULT_HEATED_SEATS}",
        "TESLA_FLEET_COLD_OUTSIDE_BELOW_C": "${TESLA_FLEET_COLD_OUTSIDE_BELOW_C}",
        "TESLA_FLEET_DEFROST_OUTSIDE_BELOW_C": "${TESLA_FLEET_DEFROST_OUTSIDE_BELOW_C}",
        "TESLA_FLEET_STEERING_WHEEL_HEAT_WHEN_COLD": "${TESLA_FLEET_STEERING_WHEEL_HEAT_WHEN_COLD}",
        "TESLA_FLEET_KEY_DOMAIN": "${TESLA_FLEET_KEY_DOMAIN}",
        "TESLA_FLEET_RATE_DATA_PER_USD": "${TESLA_FLEET_RATE_DATA_PER_USD}",
        "TESLA_FLEET_RATE_COMMANDS_PER_USD": "${TESLA_FLEET_RATE_COMMANDS_PER_USD}",
        "TESLA_FLEET_RATE_WAKES_PER_USD": "${TESLA_FLEET_RATE_WAKES_PER_USD}",
        "TESLA_FLEET_MONTHLY_DISCOUNT_USD": "${TESLA_FLEET_MONTHLY_DISCOUNT_USD}"
      }
    }
  }
}
